{{/*
  Same as Hugo's built-in sitemap, except it skips pages that are noindex
  (see partials/seo/indexable.html) and drops <lastmod> values in the
  future — upcoming events otherwise push list pages' lastmod past today,
  which search engines treat as invalid.
*/}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range where .Pages "Sitemap.Disable" "ne" true }}
    {{- if and .Permalink (partial "seo/indexable.html" .) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if and (not .Lastmod.IsZero) (le .Lastmod.Unix now.Unix) }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
  </url>
    {{- end }}
  {{- end }}
</urlset>
